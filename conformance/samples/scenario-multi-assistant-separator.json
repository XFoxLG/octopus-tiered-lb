{
  "id": "scenario-multi-assistant-separator",
  "class": "multi-assistant-separator",
  "side": "request",
  "inbound": "openai_chat",
  "outbound": "anthropic",
  "model": "claude-sonnet-4-5",
  "stream": false,
  "source": {
    "kind": "issue",
    "ref": "CLIProxyAPI#6191",
    "url": "https://github.com/router-for-me/CLIProxyAPI/issues/6191",
    "note": "codex→chat 转换把多条 assistant 消息无分隔符拼接；本样本验证多条连续 assistant 消息在跨协议转换中的分隔与合并语义"
  },
  "request": {
    "model": "claude-sonnet-4-5",
    "max_tokens": 256,
    "messages": [
      {"role": "user", "content": "Write two parts."},
      {"role": "assistant", "content": "Part one."},
      {"role": "assistant", "content": "Part two."}
    ]
  }
}
