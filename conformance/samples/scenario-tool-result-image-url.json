{
  "id": "scenario-tool-result-image-url",
  "class": "tool-result-images",
  "side": "request",
  "inbound": "anthropic",
  "outbound": "chat",
  "model": "claude-sonnet-4-5",
  "stream": false,
  "source": {
    "kind": "issue",
    "ref": "CLIProxyAPI#6264",
    "url": "https://github.com/router-for-me/CLIProxyAPI/issues/6264",
    "note": "Responses tool-result images forwarded as role tool and rejected by strict upstreams；与 v2.8.14 修复的 Anthropic 工具结果 URL 图片同族"
  },
  "request": {
    "model": "claude-sonnet-4-5",
    "max_tokens": 256,
    "messages": [
      {"role": "user", "content": "Take a look at the screenshot."},
      {
        "role": "assistant",
        "content": [
          {"type": "tool_use", "id": "toolu_conformance_1", "name": "read_file", "input": {"path": "shot.png"}}
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "tool_result",
            "tool_use_id": "toolu_conformance_1",
            "content": [
              {"type": "image", "source": {"type": "url", "url": "https://example.com/shot.png"}}
            ]
          }
        ]
      }
    ]
  }
}
